{
  "name": "insulin-captable",
  "displayName": "Cap Table",
  "version": "0.1.0",
  "description": "An open-source equity management app as Pulley alternative",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#shared": "./src/app/shared/index.ts",
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0 --port 3000",
    "build": "node scripts/check-ledger-triggers.mjs && vite build --configLoader native",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fours/app": "0.1.0-beta.0",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "nitro": "3.0.260610-beta",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260925.2",
    "@rolldown/binding-wasm32-wasi": "1.2.14",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "lightningcss": "npm:lightningcss-wasm@1.33.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "rolldown": "1.2.14",
    "source-map-js": "1.2.2"
  }
}
