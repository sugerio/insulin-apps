{
  "name": "insulin-captable",
  "displayName": "Cap Table",
  "version": "0.1.0",
  "description": "An open-source equity management app as Pulley alternative",
  "license": "MIT",
  "private": true,
  "type": "module",
  "insulin": {
    "permissions": [
      { "key": "captable.manage", "label": "Record changes", "description": "Record and reverse equity changes, run imports and manage documents. Includes viewing the whole cap table.", "role": "EDITOR" },
      { "key": "captable.view", "label": "View the cap table", "description": "See the whole cap table, stakeholders, reports and documents, read only.", "role": "EDITOR" },
      { "key": "portfolio.view", "label": "See own holdings", "description": "See their own holdings in the holder view, matched by their e-mail address.", "role": "VIEWER" }
    ],
    "navigation": [
      { "key": "dashboard", "label": "Dashboard", "icon": "layout-dashboard", "path": "/dashboard", "group": "Essentials", "role": "EDITOR" },
      { "key": "cap-table", "label": "Cap Table", "icon": "table", "path": "/captable", "role": "EDITOR",
        "children": [
          { "key": "cap-table-view", "label": "Cap Table", "icon": "table", "path": "/captable" },
          { "key": "share-classes", "label": "Share Classes", "icon": "layers", "path": "/share-classes" },
          { "key": "equity-plans", "label": "Equity Plans", "icon": "chart-pie", "path": "/equity-plans" },
          { "key": "securities-status", "label": "Securities Status", "icon": "list", "path": "/securities-status" },
          { "key": "vesting", "label": "Vesting", "icon": "calendar", "path": "/vesting" }
        ] },
      { "key": "compliance", "label": "Compliance & Tax", "icon": "shield", "path": "/compliance/409a", "role": "EDITOR" },
      { "key": "hire-and-retain", "label": "Hire and Retain", "icon": "heart", "path": "/exercise-requests", "role": "EDITOR",
        "children": [
          { "key": "exercise-requests", "label": "Exercise Requests", "icon": "inbox", "path": "/exercise-requests" },
          { "key": "hire-equity-plans", "label": "Equity Plans", "icon": "chart-pie", "path": "/equity-plans" },
          { "key": "stakeholder-portal", "label": "Stakeholder Portal", "icon": "home", "path": "/stakeholder-portal" }
        ] },
      { "key": "stakeholders", "label": "Stakeholders", "icon": "users", "path": "/stakeholders", "role": "EDITOR" },
      { "key": "company", "label": "Company", "icon": "building", "path": "/company", "role": "EDITOR",
        "children": [
          { "key": "profile", "label": "Profile & Settings", "icon": "building", "path": "/company" },
          { "key": "documents", "label": "Documents", "icon": "folder", "path": "/documents" },
          { "key": "reports", "label": "Reports", "icon": "file-text", "path": "/reports" },
          { "key": "activity", "label": "Recent Activity", "icon": "clock", "path": "/activity" }
        ] },
      { "key": "certificates", "label": "Certificates", "icon": "award", "path": "/certificates", "role": "EDITOR",
        "children": [
          { "key": "certificate-list", "label": "Certificates", "icon": "award", "path": "/certificates" },
          { "key": "legends", "label": "Legends", "icon": "file-pen", "path": "/certificates/legends" },
          { "key": "certificate-terms", "label": "Terms", "icon": "files", "path": "/certificates/terms" }
        ] },
      { "key": "portfolio", "label": "Portfolio", "icon": "chart-pie", "path": "/portfolio", "group": "My equity", "role": "VIEWER", "maxRole": "EDITOR" },
      { "key": "how-to-exercise", "label": "How to exercise", "icon": "check-circle", "path": "/portfolio/how-to-exercise", "role": "VIEWER", "maxRole": "EDITOR" },
      { "key": "my-documents", "label": "Documents", "icon": "folder", "path": "/portfolio/documents", "role": "VIEWER", "maxRole": "EDITOR" }
    ]
  },
  "imports": {
    "#shared": "./src/app/shared/index.ts",
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0 --port 3000",
    "build": "node scripts/check-ledger-triggers.mjs && vite build --configLoader native",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fours/app": "0.1.0-beta.0",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "nitro": "3.0.260610-beta",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260925.2",
    "@rolldown/binding-wasm32-wasi": "1.2.14",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "lightningcss": "npm:lightningcss-wasm@1.33.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "rolldown": "1.2.14",
    "source-map-js": "1.2.2"
  }
}
