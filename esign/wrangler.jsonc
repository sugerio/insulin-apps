{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local configuration (`npm run dev`, with .dev.vars and local D1/R2 under .wrangler/state).
  // Deployments are not described here: scripts/deploy.ts generates their configuration from
  // the environment, so no account or resource id is kept in this repository (WORKER-MODE.md).
  "name": "esign-local-experimental",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "assets": { "directory": "./dist-ui", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "esign-local", "database_id": "local-only", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "esign-local-artifacts" }, { "binding": "TEST_MAIL", "bucket_name": "esign-local-test-mail" }],
  "vars": {
    // The one switch (src/environment.ts): local runs are dev; deployments get theirs from scripts/deploy.ts.
    "ESIGN_ENV": "dev",
    // Finish each envelope after every accepted signature: process it, then seal after the last.
    "COMPLETE_AFTER_SIGN": "true",
    // Origins allowed to embed /sign in an iframe (space-separated).
    "SIGNING_PAGE_FRAME_ANCESTORS": "http://localhost:3000"
  },
  // Retries envelopes whose after-signature work did not finish.
  "triggers": { "crons": ["*/5 * * * *"] }
}
